{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "autoIncrement": true, "android": { "buildType": "app-bundle" } }
  },
  "submit": {
    "ci": {
      "android": { "serviceAccountKeyPath": "./play-service-account.json", "track": "internal" },
      "ios": {}
    },
    "production": {
      "android": { "serviceAccountKeyPath": "./play-service-account.json", "track": "production" },
      "ios": {}
    }
  }
}
